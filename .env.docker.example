# Copy to .env.docker for `docker compose up`. All optional; leave a value empty to keep the default.

# AI-written answers and summaries (https://console.groq.com/keys)
GROQ_API_KEY=
# Full CI logs and 5,000 GitHub API calls/hour
GITHUB_TOKEN=
# GitHub webhook secret for the ingestion service
GITHUB_WEBHOOK_SECRET=

# Shared secret between dashboard and API (set a long random value outside local testing)
AEIP_SERVICE_TOKEN=
# Key required by POST /api/events from outside tools
AEIP_INGEST_KEY=

# Sign-in (all three set = login required). OAuth callback: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
AEIP_ADMINS=
AEIP_MEMBERS=
AEIP_VIEWERS=
AEIP_DEFAULT_ROLE=
