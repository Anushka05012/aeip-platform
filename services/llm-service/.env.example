# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GitHub token for live repository analysis (Settings > Developer settings >
# Personal access tokens; read-only "public_repo" / "repo" scope is enough).
# Without it GitHub allows only 60 API calls/hour, about one repository analysis.
GITHUB_TOKEN=

# Ingestion service (ingestion/webhook-listener.ts) that stores commits and pull
# requests in PostgreSQL. Analysis still works when it is not running.
INGESTION_API_URL=http://localhost:4000

# Default chat model used by GroqClient. Verify current available model IDs
# at https://console.groq.com/docs/models before relying on this in demos —
# Groq's lineup changes over time.
GROQ_MODEL=openai/gpt-oss-120b

# Chunking defaults (tokens are approximate, measured with tiktoken cl100k_base
# as a stand-in encoder for sizing purposes only)
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Security (leave empty for local development) -------------------------------
# Shared secret between the dashboard and this API. When set, only callers that send it
# (the dashboard's /api/aeip proxy) are accepted, and the forwarded role is enforced.
# Use the same value as AEIP_SERVICE_TOKEN in frontend/.env.local. Generate: openssl rand -hex 32
AEIP_SERVICE_TOKEN=
# Key that outside tools must send to POST /api/events (X-AEIP-Key header, Bearer, or ?key=).
AEIP_INGEST_KEY=
# Extra browser origins allowed by CORS, comma-separated (the dashboard normally proxies instead).
AEIP_ALLOWED_ORIGINS=
# Bind address: 0.0.0.0 inside containers / on a host, 127.0.0.1 locally.
AEIP_HOST=127.0.0.1
