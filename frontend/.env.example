# Copy to frontend/.env.local. Everything is optional for local development.

# Where the dashboard's server-side proxy reaches the intelligence API.
INTELLIGENCE_API_URL=http://localhost:8001

# --- Login (SEC-01/02/03). All three set = sign-in required; any missing = open local mode.
# Create a GitHub OAuth app: GitHub > Settings > Developer settings > OAuth Apps > New.
#   Homepage URL:      http://localhost:3000        (or your deployed URL)
#   Callback URL:      http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs session cookies. Generate: openssl rand -hex 32
AUTH_SECRET=
# Public URL of the dashboard when it is behind a proxy/host (used for the OAuth callback).
AEIP_PUBLIC_URL=

# Roles: comma-separated GitHub logins.
#   admin  - everything, including sending events from the dashboard
#   member - analyse repositories, explain failures, ask the codebase, AI summaries
#   viewer - read dashboards only
AEIP_ADMINS=
AEIP_MEMBERS=
AEIP_VIEWERS=
# Role for any other GitHub user: viewer or member. Leave empty to deny everyone not listed.
AEIP_DEFAULT_ROLE=

# Same value as AEIP_SERVICE_TOKEN in services/llm-service/.env
AEIP_SERVICE_TOKEN=

# Ingestion service (PostgreSQL storage), read by the Repositories page.
NEXT_PUBLIC_INGESTION_API_URL=http://localhost:4000
